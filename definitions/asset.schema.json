{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.northshoreautomation.com/schemas/oasis/2/asset.schema.json",
  "title": "OASIS 2.0 asset",
  "description": "An asset record: a described content item with its versions, files, file groups, relationships, metadata, annotations, and collection memberships.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/record_base"
    },
    {
      "$ref": "common.schema.json#/$defs/timeline_rules"
    },
    {
      "$ref": "#/$defs/version_placement"
    }
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "created": {
      "$ref": "common.schema.json#/$defs/date_time"
    },
    "modified": {
      "$ref": "common.schema.json#/$defs/date_time"
    },
    "deleted": {
      "$ref": "common.schema.json#/$defs/date_time"
    },
    "timing": {
      "$ref": "common.schema.json#/$defs/timing"
    },
    "versions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/version"
      }
    },
    "current_version": {
      "$ref": "common.schema.json#/$defs/reference"
    },
    "unassigned": {
      "$ref": "common.schema.json#/$defs/unassigned"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/file"
      }
    },
    "file_groups": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/file_group"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/relationship"
      }
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/embedded_annotation"
      }
    },
    "member_of": {
      "$ref": "common.schema.json#/$defs/member_of"
    },
    "access": {
      "$ref": "common.schema.json#/$defs/access"
    }
  },
  "required": [
    "title"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "version_placement": {
      "description": "VER-4 and VER-5. With versions, the asset level holds only information about the whole asset and has no timeline. Without versions, the asset level is the implied original version.",
      "if": {
        "required": [
          "versions"
        ],
        "properties": {
          "versions": {
            "minItems": 1
          }
        }
      },
      "then": {
        "properties": {
          "timing": false,
          "file_groups": {
            "items": {
              "$ref": "common.schema.json#/$defs/without_part_starts"
            }
          },
          "annotations": {
            "items": {
              "$ref": "common.schema.json#/$defs/without_position"
            }
          },
          "relationships": {
            "items": {
              "$ref": "common.schema.json#/$defs/not_subclip"
            }
          }
        }
      },
      "else": {
        "properties": {
          "current_version": false,
          "unassigned": false
        }
      }
    }
  }
}
