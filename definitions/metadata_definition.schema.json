{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.northshoreautomation.com/schemas/oasis/2/metadata_definition.schema.json",
  "title": "OASIS 2.0 metadata definition",
  "description": "A metadata definition record: a field's label, value type, cardinality, enum options and list type, and informative constraints. Its id names the field.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/record_base"
    },
    {
      "if": {
        "properties": {
          "value_type": {
            "const": "enum"
          }
        }
      },
      "then": {
        "required": [
          "options",
          "list_type"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "options"
              ]
            },
            {
              "required": [
                "list_type"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "value_type": {
            "not": {
              "enum": [
                "integer",
                "number"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "constraints": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "minimum"
                  ]
                },
                {
                  "required": [
                    "maximum"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "value_type": {
            "not": {
              "const": "string"
            }
          }
        }
      },
      "then": {
        "properties": {
          "constraints": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "min_length"
                  ]
                },
                {
                  "required": [
                    "max_length"
                  ]
                },
                {
                  "required": [
                    "pattern"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ],
  "properties": {
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "value_type": {
      "enum": [
        "string",
        "integer",
        "number",
        "boolean",
        "date",
        "datetime",
        "enum",
        "asset_reference",
        "collection_reference"
      ]
    },
    "cardinality": {
      "enum": [
        "single",
        "multiple"
      ]
    },
    "list_type": {
      "enum": [
        "fixed",
        "open"
      ]
    },
    "options": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/option"
      }
    },
    "constraints": {
      "$ref": "common.schema.json#/$defs/constraints"
    },
    "required": {
      "type": "boolean"
    }
  },
  "required": [
    "value_type",
    "cardinality"
  ],
  "unevaluatedProperties": false
}
