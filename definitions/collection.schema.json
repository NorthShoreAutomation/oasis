{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.northshoreautomation.com/schemas/oasis/2/collection.schema.json",
  "title": "OASIS 2.0 collection",
  "description": "A collection record: a named grouping with a collection type. Membership is recorded on each member. A storage collection declares the storage it mirrors.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/record_base"
    },
    {
      "if": {
        "required": [
          "collection_type"
        ],
        "properties": {
          "collection_type": {
            "const": "storage"
          }
        }
      },
      "then": {
        "required": [
          "storage"
        ]
      },
      "else": {
        "not": {
          "required": [
            "storage"
          ]
        }
      }
    }
  ],
  "properties": {
    "title": {
      "$ref": "common.schema.json#/$defs/nonempty_string"
    },
    "collection_type": {
      "description": "The type of grouping: logical, storage (mirrors a location in a storage system), or other.",
      "enum": [
        "logical",
        "storage",
        "other"
      ]
    },
    "description": {
      "type": "string"
    },
    "storage": {
      "$ref": "common.schema.json#/$defs/collection_storage"
    },
    "member_of": {
      "$ref": "common.schema.json#/$defs/member_of"
    },
    "created": {
      "$ref": "common.schema.json#/$defs/date_time"
    },
    "modified": {
      "$ref": "common.schema.json#/$defs/date_time"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "access": {
      "$ref": "common.schema.json#/$defs/access"
    }
  },
  "required": [
    "title",
    "collection_type"
  ],
  "unevaluatedProperties": false
}
