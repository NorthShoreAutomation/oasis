{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.northshoreautomation.com/schemas/oasis/2/storage_location.schema.json",
  "title": "OASIS 2.0 storage location",
  "description": "A storage location record: a named place where files live, with a storage system and a root. It carries no secret values. Validation never connects to it.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/record_base"
    },
    {
      "if": {
        "required": [
          "system"
        ],
        "properties": {
          "system": {
            "enum": [
              "network_share",
              "s3",
              "gcs",
              "azure_blob",
              "tape"
            ]
          }
        }
      },
      "then": {
        "required": [
          "root"
        ],
        "properties": {
          "root": {
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "system"
        ],
        "properties": {
          "system": {
            "enum": [
              "s3",
              "gcs"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "root": {
            "pattern": "^[^/]+$"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "system"
        ],
        "properties": {
          "system": {
            "const": "azure_blob"
          }
        }
      },
      "then": {
        "properties": {
          "root": {
            "pattern": "^[^/]+/[^/]+$"
          }
        }
      }
    }
  ],
  "properties": {
    "name": {
      "$ref": "common.schema.json#/$defs/nonempty_string"
    },
    "system": {
      "enum": [
        "source_local",
        "network_share",
        "s3",
        "gcs",
        "azure_blob",
        "tape",
        "other"
      ]
    },
    "root": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "created": {
      "$ref": "common.schema.json#/$defs/date_time"
    },
    "modified": {
      "$ref": "common.schema.json#/$defs/date_time"
    }
  },
  "required": [
    "name",
    "system"
  ],
  "unevaluatedProperties": false
}
